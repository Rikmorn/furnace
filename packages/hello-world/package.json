{
  "name": "@furnace/hello-world",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot serve.ts",
    "dev:native": "bunx furnace dev --platform=macos",
    "build:web": "bun build src/index.html --outdir ../../dist/web --minify --sourcemap=external",
    "build:web:dev": "bun build src/index.html --outdir ../../dist/web/dev --sourcemap=inline",
    "build:macos": "bunx furnace build --platform=macos",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@furnace/core": "workspace:*"
  },
  "devDependencies": {
    "@furnace/tools": "workspace:*",
    "bun-plugin-svelte": "^0.0.6",
    "svelte": "^5.55.7"
  }
}
