{
  "name": "@furnace/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/entry.ts",
  "scripts": {
    "dev": "bun --hot serve.ts",
    "dev:native": "bun run build:native && ../../target/release/furnace-window",
    "build:web": "bun build index.html --outdir ../../dist/web --minify --sourcemap=external",
    "build:native": "cargo build --release --manifest-path native/Cargo.toml",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit"
  }
}
