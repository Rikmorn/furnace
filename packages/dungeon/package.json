{
  "name": "@furnace/dungeon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bake:default": "bun scripts/bake-default-world.ts",
    "dev": "bun --hot serve.ts",
    "build:web": "bun build src/index.html --outdir ../../dist/dungeon --minify --sourcemap=external",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "edit": "bun run --cwd ../editor build:frontend && bun ../editor/src/daemon/main.ts"
  },
  "dependencies": {
    "@furnace/core": "workspace:*"
  },
  "devDependencies": {
    "@furnace/editor": "workspace:*",
    "bun-webgpu": "^0.1.0"
  }
}
